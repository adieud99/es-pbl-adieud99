PUT /flights
{
  "settings": {
    "number_of_shards": 3,
    "number_of_replicas": 1,
    "analysis": {
      "analyzer": {
        "korean_search": {
          "type": "standard",
          "stopwords": "_none_"
        }
      }
    }
  },
  "mappings": {
    "dynamic": "strict",
    "properties": {
      "trip_id": { "type": "keyword" },
      "route_desc": {
        "type": "text",
        "analyzer": "korean_search"
      },
      "airline": {
        "type": "text",
        "analyzer": "korean_search",
        "fields": {
          "keyword": {
            "type": "keyword",
            "ignore_above": 256
          }
        }
      },
      "dep_airport": { "type": "keyword" },
      "arr_airport": { "type": "keyword" },
      "seat_class": { "type": "keyword" },
      "out_dep_time": { "type": "date" },
      "stay_nights": { "type": "integer" },
      "total_price": { "type": "integer" },
      "is_direct": { "type": "boolean" },
      "tags": { "type": "keyword" }
    }
  }
}

GET /flights/_mapping

GET /_cat/shards/flights?v